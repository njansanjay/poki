<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.2.0</Version>
    <AssemblyTitle>Poki</AssemblyTitle>
    <Product>POKI</Product>
    <Description>Animated desktop cat and shortcut launcher.</Description>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\poki.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="Assets\robot-head.png" />
    <EmbeddedResource Include="Assets\cat-sprites.png" />
    <EmbeddedResource Include="Assets\cat-slim.png" />
    <EmbeddedResource Include="Assets\cat-lean.png" />
    <EmbeddedResource Include="Assets\cat-chubby.png" />
    <EmbeddedResource Include="Assets\cat-extra-chubby.png" />
    <EmbeddedResource Include="Assets\cat-mark.png" />
    <EmbeddedResource Include="Assets\poki.ico" />
    <None Update="oauth.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
